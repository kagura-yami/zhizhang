// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model User {
  id          String    @id @default(uuid()) @db.Uuid // 用户唯一标识ID
  username    String    @unique @db.VarChar(50)        // 用户名，唯一
  password    String    @db.VarChar(255)               // 加密后的密码
  email       String?   @unique @db.VarChar(100)       // 邮箱地址，可选，唯一
  nickname    String?   @db.VarChar(50)                // 昵称，可选
  avatar      String?   @db.Text                       // 头像URL，可选
  isActive    Boolean   @default(true) @map("is_active") // 账户是否激活
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6) // 最后登录时间
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6) // 创建时间
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)      // 更新时间

  // 关联关系
  bills          Bill[]           // 用户的所有账单记录
  categories     Category[]       // 用户的自定义分类
  accounts       Account[]        // 用户的账户
  budgets        Budget[]         // 用户的预算
  financialGoals FinancialGoal[]  // 用户的财务目标
  aiModelConfigs AIModelConfig[]  // 用户的AI模型配置
  chatSessions   ChatSession[]    // 用户的AI聊天会话
  biometricCredentials BiometricCredential[] // 绑定到账号的设备生物识别凭据
  invoiceMailbox InvoiceMailbox? // 用户的收票邮箱配置
  invoices       Invoice[]        // 用户整理后的电子发票
  notificationSamples NotificationSample[]
  socialPreference SocialPreference?
  rankingState RankingState?
  following SocialFollow[] @relation("SocialFollower")
  followers SocialFollow[] @relation("SocialFollowee")
  blockedUsers SocialBlock[] @relation("SocialBlocker")
  blockedBy SocialBlock[] @relation("SocialBlocked")
  givenReviewGrants ReviewGrant[] @relation("GrantOwner")
  receivedReviewGrants ReviewGrant[] @relation("GrantReviewer")
  incomingReviewRequests ReviewRequest[] @relation("RequestOwner")
  outgoingReviewRequests ReviewRequest[] @relation("RequestApplicant")
  socialInboxEvents SocialInboxEvent[]
  ownedReviewThreads BillReviewThread[] @relation("ThreadOwner")
  writtenReviewThreads BillReviewThread[] @relation("ThreadReviewer")
  reviewMessages ReviewMessage[]
  reviewReports ReviewReport[]
  ownedBillNotices NewBillNotice[] @relation("NoticeOwner")
  receivedBillNotices NewBillNotice[] @relation("NoticeReviewer")

  @@map("users")
  @@schema("public")
}

model SocialPreference {
  userId String @id @map("user_id") @db.Uuid
  enabledAt DateTime @map("enabled_at") @db.Timestamptz(6)
  consentVersion String @map("consent_version") @db.VarChar(30)
  allowAiFeedback Boolean @default(false) @map("allow_ai_feedback")
  publicRelations Boolean @default(false) @map("public_relations")
  rankingScope String @default("none") @map("ranking_scope") @db.VarChar(10)
  showRankingAmount Boolean @default(false) @map("show_ranking_amount")
  notifyNewBills Boolean @default(true) @map("notify_new_bills")
  notifyInteractions Boolean @default(true) @map("notify_interactions")
  notificationPreview Boolean @default(false) @map("notification_preview")
  requestRejectStreak Int @default(0) @map("request_reject_streak")
  requestCooldownUntil DateTime? @map("request_cooldown_until") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("social_preferences")
  @@schema("public")
}

model RankingLaunch {
  id Int @id @default(1)
  launchedAt DateTime @default(now()) @map("launched_at") @db.Timestamptz(6)
  @@map("ranking_launch")
  @@schema("public")
}

model RankingState {
  userId String @id @map("user_id") @db.Uuid
  initialized Boolean @default(false)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  dayKey String @map("day_key") @db.VarChar(10)
  monthKey String @map("month_key") @db.VarChar(7)
  yearKey String @map("year_key") @db.VarChar(4)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  results RankingResult[]
  @@map("ranking_states")
  @@schema("public")
}

model RankingResult {
  userId String @map("user_id") @db.Uuid
  kind String @db.VarChar(5)
  period String @db.VarChar(10)
  surplus Decimal @db.Decimal(30, 4)
  effectiveDays Int @map("effective_days")
  included Int
  needsReview Int @map("needs_review")
  ruleVersion String @map("rule_version") @db.VarChar(30)
  state RankingState @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@id([userId, kind, period])
  @@index([kind, period, surplus, effectiveDays])
  @@map("ranking_results")
  @@schema("public")
}

model SocialFollow {
  generation String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId String @map("follower_id") @db.Uuid
  followeeId String @map("followee_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower User @relation("SocialFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("SocialFollowee", fields: [followeeId], references: [id], onDelete: Cascade)
  @@id([followerId, followeeId])
  @@index([followeeId, followerId])
  @@map("social_follows")
  @@schema("public")
}

model SocialBlock {
  blockerId String @map("blocker_id") @db.Uuid
  blockedId String @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker User @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("social_blocks")
  @@schema("public")
}

model ReviewGrant {
  ownerId String @map("owner_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  scope String @default("expense") @db.VarChar(10)
  historyStart DateTime? @map("history_start") @db.Date
  activatedAt DateTime @map("activated_at") @db.Timestamptz(6)
  status String @default("active") @db.VarChar(10)
  version Int @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner User @relation("GrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer User @relation("GrantReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  @@id([ownerId, reviewerId])
  @@index([reviewerId, status])
  @@map("review_grants")
  @@schema("public")

}

model ReviewRequest {
  ownerId String @map("owner_id") @db.Uuid
  applicantId String @map("applicant_id") @db.Uuid
  status String @default("pending") @db.VarChar(20)
  version Int @default(1)
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  owner User @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  applicant User @relation("RequestApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  @@id([ownerId, applicantId])
  @@index([applicantId, status])
  @@index([ownerId, status, requestedAt])
  @@map("review_requests")
  @@schema("public")
}

// Durable in-app events; delivery and read cursors are implemented separately.
model SocialInboxEvent {
  id Int @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  kind String @db.VarChar(40)
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(200)
  payload Json
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, id])
  @@map("social_inbox_events")
  @@schema("public")
}

model NewBillNotice {
  id Int @id @default(autoincrement())
  ownerId String @map("owner_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  grantActivatedAt DateTime @map("grant_activated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  dueAt DateTime @map("due_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  retryAt DateTime? @map("retry_at") @db.Timestamptz(6)
  attempts Int @default(0)
  owner User @relation("NoticeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer User @relation("NoticeReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  items NewBillNoticeItem[]
  @@index([processedAt, dueAt, id])
  @@index([ownerId, reviewerId, processedAt, dueAt])
  @@map("new_bill_notices")
  @@schema("public")
}

model NewBillNoticeItem {
  noticeId Int @map("notice_id")
  billId Int @map("bill_id")
  notice NewBillNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  @@id([noticeId, billId])
  @@index([billId])
  @@map("new_bill_notice_items")
  @@schema("public")
}

model BillReviewThread {
  id Int @id @default(autoincrement())
  ownerId String @map("owner_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  billId Int? @map("bill_id")
  originalBillId Int @map("original_bill_id")
  vote String @db.VarChar(5)
  snapshot Json
  initialBillUpdatedAt DateTime @map("initial_bill_updated_at") @db.Timestamptz(6)
  snapshotUpdatedAt DateTime @map("snapshot_updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner User @relation("ThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer User @relation("ThreadReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  bill Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  messages ReviewMessage[]
  reports ReviewReport[]
  @@unique([originalBillId, reviewerId])
  @@index([ownerId, id])
  @@index([reviewerId, id])
  @@index([billId])
  @@map("bill_review_threads")
  @@schema("public")
}

model ReviewMessage {
  id Int @id @default(autoincrement())
  threadId Int @map("thread_id")
  authorId String @map("author_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  mainSlot Int? @map("main_slot")
  body String @db.Text
  withdrawn Boolean @default(false)
  hidden Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  thread BillReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions ReviewMessageVersion[]
  reports ReviewReport[]
  @@unique([threadId, mainSlot])
  @@unique([threadId, authorId, clientKey])
  @@index([threadId, id])
  @@map("review_messages")
  @@schema("public")
}

model ReviewMessageVersion {
  id Int @id @default(autoincrement())
  messageId Int @map("message_id")
  revision Int
  body String @db.Text
  withdrawn Boolean
  action String @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message ReviewMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([messageId, revision])
  @@map("review_message_versions")
  @@schema("public")
}

model ReviewReport {
  id Int @id @default(autoincrement())
  reporterId String? @map("reporter_id") @db.Uuid
  threadId Int? @map("thread_id")
  messageId Int? @map("message_id")
  originalMessageId Int @map("original_message_id")
  reportedRevision Int @map("reported_revision")
  ownerId String @map("owner_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  reason String @db.Text
  status String @default("pending") @db.VarChar(20)
  disclosureVersion String @map("disclosure_version") @db.VarChar(30)
  decisionReason String? @map("decision_reason") @db.Text
  decidedBy String? @map("decided_by") @db.VarChar(100)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  thread BillReviewThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  message ReviewMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  evidence ReviewReportEvidence[]
  audit ReviewModerationAudit[]
  @@unique([reporterId, originalMessageId, reportedRevision])
  @@index([status, id])
  @@map("review_reports")
  @@schema("public")
}

model ReviewReportEvidence {
  id Int @id @default(autoincrement())
  reportId Int @map("report_id")
  originalMessageId Int @map("original_message_id")
  authorId String @map("author_id") @db.Uuid
  isMain Boolean @map("is_main")
  body String @db.Text
  withdrawn Boolean
  hidden Boolean
  revision Int
  versions Json
  messageCreatedAt DateTime @map("message_created_at") @db.Timestamptz(6)
  report ReviewReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@unique([reportId, originalMessageId])
  @@map("review_report_evidence")
  @@schema("public")
}

model ReviewModerationAudit {
  id Int @id @default(autoincrement())
  reportId Int @map("report_id")
  actor String @db.VarChar(100)
  action String @db.VarChar(20)
  reason String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  report ReviewReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId, id])
  @@map("review_moderation_audit")
  @@schema("public")
}

model BiometricCredential {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  credentialHash String    @unique @map("credential_hash") @db.VarChar(128)
  deviceLabel    String?   @map("device_label") @db.VarChar(100)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("biometric_credentials")
  @@schema("public")
}

model AIModelConfig {
  id             Int      @id @default(autoincrement())                            // 配置ID，自增主键
  userId         String   @map("user_id") @db.Uuid                                 // 所属用户ID，必填
  name           String   @db.VarChar(100)                                         // 显示名称，如"我的 Claude"
  provider       String   @db.VarChar(50)                                          // 服务商: claude | openai | deepseek | qwen
  apiKey         String   @map("api_key") @db.Text                                 // API Key（加密存储）
  apiBaseUrl     String?  @map("api_base_url") @db.VarChar(255)                    // 自定义 API 地址（可选）
  model          String   @db.VarChar(100)                                         // 模型名称（如 claude-sonnet-4-20250514）
  isDefault      Boolean  @default(false) @map("is_default")                       // 是否默认
  supportsVision Boolean  @default(false) @map("supports_vision")                  // 是否支持图片
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // 关联用户，级联删除

  @@index([userId])            // 索引：用户ID
  @@index([userId, isDefault]) // 复合索引：用户ID + 是否默认
  @@map("ai_model_configs")
  @@schema("public")
}

model Category {
  id          Int      @id @default(autoincrement())                            // 分类ID，自增主键
  name        String   @db.VarChar(100)                                         // 分类名称，如"餐饮"、"交通"等
  type        String   @db.VarChar(10)                                          // 分类类型：'income'(收入) 或 'expense'(支出)
  icon        String?  @db.VarChar(10)                                          // 分类图标，emoji表情，可选
  color       String?  @db.VarChar(20)                                          // 分类颜色，十六进制色值，可选
  isDefault   Boolean  @default(false) @map("is_default")                       // 是否为系统默认分类
  sortOrder   Int      @default(0) @map("sort_order")                           // 排序序号，用于分类显示顺序
  userId      String?  @map("user_id") @db.Uuid                                 // 所属用户ID，null表示系统默认分类
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade) // 关联用户，级联删除
  bills   Bill[]                                                                    // 该分类下的所有账单
  budgets Budget[]                                                                  // 该分类下的预算

  @@index([userId, type])  // 复合索引：用户ID + 分类类型
  @@index([isDefault])     // 索引：是否默认分类
  @@map("categories")
  @@schema("public")
}

model Bill {
  id          Int       @id @default(autoincrement())                            // 账单ID，自增主键
  amount      Decimal   @db.Decimal(15, 4)                                       // 金额，支持15位数字，4位小数
  type        String    @db.VarChar(10)                                          // 账单类型：'income'(收入) 或 'expense'(支出)
  description String?   @db.Text                                                 // 账单描述/备注，可选
  date        DateTime  @db.Date                                                 // 账单日期
  time        DateTime? @db.Timestamptz(6)                                       // 具体时间，可选
  paymentChannel String? @map("payment_channel") @db.VarChar(50)                 // 支付渠道，如微信支付、支付宝、银行卡
  counterparty String?   @db.VarChar(200)                                         // 交易对象/商户，可选
  categoryId  Int?      @map("category_id")                                      // 关联分类ID，可选
  accountId   Int?      @map("account_id")                                       // 关联账户ID，可选
  userId      String    @map("user_id") @db.Uuid                                 // 所属用户ID，必填
  tags        String[]  @default([])                                             // 标签数组
  notes       String?   @db.Text                                                 // 备注，可选
  receiptUrl  String?   @map("receipt_url") @db.Text                             // 收据图片URL，可选
  source      String    @default("manual") @db.VarChar(20)                       // 来源：manual/voice/ocr/text/notification
  sourceApp   String?   @map("source_app") @db.VarChar(50)                       // 自动记账来源应用：wechat/alipay/bank_sms 等
  relatedBillId Int?    @map("related_bill_id")                                  // 退款收入对应的原支出账单
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)    // 关联用户，级联删除
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // 关联分类，删除分类时设为null
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)  // 关联账户，删除账户时设为null
  invoices    Invoice[] // 由收票邮箱匹配到该账单的发票
  relatedBill Bill?     @relation("BillRefund", fields: [relatedBillId], references: [id], onDelete: SetNull)
  refunds     Bill[]    @relation("BillRefund")
  financialClassification BillFinancialClassification?
  reviewThreads BillReviewThread[]
  newBillNoticeItems NewBillNoticeItem[]

  @@index([userId, date])    // 复合索引：用户ID + 日期，用于按日期查询用户账单
  @@index([userId, type])    // 复合索引：用户ID + 类型，用于按类型统计
  @@index([categoryId])      // 索引：分类ID
  @@index([accountId])       // 索引：账户ID
  @@index([source])          // 索引：来源
  @@index([relatedBillId])   // 索引：退款关联的原支出
  @@map("bills")
  @@schema("public")
}

model InvoiceMailbox {
  id                  Int       @id @default(autoincrement())
  userId              String    @unique @map("user_id") @db.Uuid
  email               String    @db.VarChar(200)
  provider            String    @db.VarChar(30)
  imapHost            String    @map("imap_host") @db.VarChar(255)
  imapPort            Int       @default(993) @map("imap_port")
  secure              Boolean   @default(true)
  username            String    @db.VarChar(200)
  credentialEncrypted String    @map("credential_encrypted") @db.Text
  oauthRefreshTokenEncrypted String? @map("oauth_refresh_token_encrypted") @db.Text
  oauthExpiresAt      DateTime? @map("oauth_expires_at") @db.Timestamptz(6)
  enabled             Boolean   @default(true)
  status              String    @default("ready") @db.VarChar(30)
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastFullScanAt      DateTime? @map("last_full_scan_at") @db.Timestamptz(6)
  lastUid             String?   @map("last_uid") @db.VarChar(30)
  lastError           String?   @map("last_error") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([enabled, lastSyncedAt])
  @@map("invoice_mailboxes")
  @@schema("public")
}

model Invoice {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.Uuid
  mailboxId      Int?      @map("mailbox_id")
  billId         Int?      @map("bill_id")
  messageId      String?   @map("message_id") @db.VarChar(500)
  attachmentHash String    @map("attachment_hash") @db.VarChar(64)
  fileName       String    @map("file_name") @db.VarChar(255)
  storagePath    String    @map("storage_path") @db.Text
  mimeType       String?   @map("mime_type") @db.VarChar(100)
  subject        String?   @db.VarChar(500)
  sender         String?   @db.VarChar(300)
  seller         String?   @db.VarChar(300)
  buyer          String?   @db.VarChar(300)
  invoiceCategory String?  @map("invoice_category") @db.VarChar(300)
  contentText    String?   @map("content_text") @db.Text
  invoiceNumber  String?   @map("invoice_number") @db.VarChar(100)
  amount         Decimal?  @db.Decimal(15, 4)
  invoiceDate    DateTime? @map("invoice_date") @db.Date
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  status         String    @default("unmatched") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailbox InvoiceMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  bill    Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([userId, attachmentHash])
  @@index([userId, receivedAt])
  @@index([userId, status])
  @@index([billId])
  @@map("invoices")
  @@schema("public")
}

model Account {
  id          Int      @id @default(autoincrement())                            // 账户ID，自增主键
  name        String   @db.VarChar(100)                                         // 账户名称
  type        String   @db.VarChar(20)                                          // 账户类型：bank_card/e_wallet/credit_card/cash
  balance     Decimal  @default(0) @db.Decimal(15, 4)                           // 账户余额
  icon        String?  @db.VarChar(10)                                          // 账户图标，emoji表情，可选
  color       String?  @db.VarChar(20)                                          // 账户颜色，十六进制色值，可选
  isDefault   Boolean  @default(false) @map("is_default")                       // 是否为默认账户
  sortOrder   Int      @default(0) @map("sort_order")                           // 排序序号
  userId      String   @map("user_id") @db.Uuid                                 // 所属用户ID，必填
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade) // 关联用户，级联删除
  bills Bill[]                                                                  // 该账户下的所有账单

  @@index([userId])          // 索引：用户ID
  @@index([userId, type])    // 复合索引：用户ID + 账户类型
  @@map("accounts")
  @@schema("public")
}

model Budget {
  id          Int      @id @default(autoincrement())                            // 预算ID，自增主键
  name        String   @db.VarChar(100)                                         // 预算名称
  amount      Decimal  @db.Decimal(15, 4)                                       // 预算金额
  period      String   @db.VarChar(20)                                          // 预算周期：monthly/yearly
  categoryId  Int?     @map("category_id")                                      // 关联分类ID，可选（null表示总预算）
  alertAt     Int      @default(80)                                             // 超支提醒百分比，默认80%
  isActive    Boolean  @default(true) @map("is_active")                         // 是否启用
  userId      String   @map("user_id") @db.Uuid                                 // 所属用户ID，必填
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)    // 关联用户，级联删除
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // 关联分类，删除分类时设为null

  @@index([userId])          // 索引：用户ID
  @@index([userId, period])  // 复合索引：用户ID + 周期
  @@index([categoryId])      // 索引：分类ID
  @@map("budgets")
  @@schema("public")
}

model FinancialGoal {
  id            Int       @id @default(autoincrement())                            // 目标ID，自增主键
  name          String    @db.VarChar(100)                                         // 目标名称，如"攒首付"
  targetAmount  Decimal   @map("target_amount") @db.Decimal(15, 4)                // 目标金额
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(15, 4)   // 当前已存金额
  deadline      DateTime? @db.Date                                                 // 截止日期，可选
  icon          String?   @db.VarChar(10)                                          // emoji图标，可选
  color         String?   @db.VarChar(20)                                          // 颜色，可选
  isCompleted   Boolean   @default(false) @map("is_completed")                     // 是否已完成
  userId        String    @map("user_id") @db.Uuid                                 // 所属用户ID，必填
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // 关联用户，级联删除

  @@index([userId])          // 索引：用户ID
  @@map("financial_goals")
  @@schema("public")
}

model AppVersion {
  id          Int      @id @default(autoincrement())                            // 版本ID，自增主键
  version     String   @unique @db.VarChar(20)                                  // 版本号，如 "1.2.3"
  versionCode Int      @unique @map("version_code")                             // Android versionCode，如 10203
  downloadUrl String   @map("download_url") @db.Text                            // APK 下载链接
  updateLog   String   @map("update_log") @db.Text                              // 更新日志
  forceUpdate Boolean  @default(false) @map("force_update")                     // 是否强制更新
  platform    String   @default("android") @db.VarChar(20)                      // 平台：android/ios
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间

  @@index([platform])        // 索引：平台
  @@map("app_versions")
  @@schema("public")
}

model ChatSession {
  id          Int       @id @default(autoincrement())                            // 会话ID，自增主键
  userId      String    @map("user_id") @db.Uuid                                 // 所属用户ID
  title       String?   @db.VarChar(200)                                         // 会话标题（自动从首条消息生成）
  summary     String?   @db.Text                                                 // 旧消息压缩摘要
  summaryUpTo Int?      @map("summary_up_to")                                    // 摘要覆盖到的消息序号
  aiConfigId  Int?      @map("ai_config_id")                                     // 使用的AI配置ID
  isActive    Boolean   @default(true) @map("is_active")                         // 是否激活（软删除）
  isPinned    Boolean   @default(false) @map("is_pinned")                        // 是否置顶
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)        // 更新时间

  // 关联关系
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, isActive])
  @@map("chat_sessions")
  @@schema("public")
}

model HotUpdate {
  id               Int      @id @default(autoincrement())
  bundleVersion    Int      @unique @map("bundle_version")
  targetVersion    String   @map("target_version") @db.VarChar(20)    // 对应的 nativeVersion
  minNativeCode    Int      @map("min_native_code")                   // 最低兼容原生版本码
  maxNativeCode    Int?     @map("max_native_code")                   // 最高兼容原生版本码
  bundleType       String   @default("business") @map("bundle_type") @db.VarChar(20) // full | business
  downloadUrl      String   @map("download_url") @db.Text             // 完整包下载链接
  fileHash         String   @map("file_hash") @db.VarChar(64)         // 完整包 SHA256
  fileSize         Int      @map("file_size")                          // 完整包大小 (bytes)
  // bsdiff 补丁字段
  patchFromVersion Int?     @map("patch_from_version")                 // 基于哪个版本的 diff
  patchUrl         String?  @map("patch_url") @db.Text                 // diff 补丁下载链接
  patchHash        String?  @map("patch_hash") @db.VarChar(64)         // 补丁 SHA256
  patchSize        Int?     @map("patch_size")                         // 补丁大小 (bytes)
  // 元数据
  updateLog        String   @map("update_log") @db.Text
  forceUpdate      Boolean  @default(false) @map("force_update")
  isActive         Boolean  @default(true) @map("is_active")
  platform         String   @default("android") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([platform, isActive])
  @@map("hot_updates")
  @@schema("public")
}

// A classification is valid only for the exact bill revision the owner reviewed.
model BillFinancialClassification {
  billId        Int      @id @map("bill_id")
  kind          String   @db.VarChar(30)
  currency      String   @default("CNY") @db.VarChar(3)
  billUpdatedAt DateTime @map("bill_updated_at") @db.Timestamptz(6)
  reviewedAt    DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_financial_classifications")
  @@schema("public")
}

model NotificationSample {
  id Int @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  sampleId String @map("sample_id") @db.VarChar(64)
  packageName String @map("package_name") @db.VarChar(200)
  appVersion String @map("app_version") @db.VarChar(30)
  ruleVersion String @map("rule_version") @db.VarChar(50)
  postedAt DateTime @map("posted_at") @db.Timestamptz(6)
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)
  status String @db.VarChar(30)
  reason String @db.VarChar(200)
  raw Json
  parsed Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sampleId])
  @@index([capturedAt, id])
  @@index([userId, capturedAt])
  @@index([status, packageName])
  @@map("notification_samples")
  @@schema("public")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json
  category    String   @default("general") @db.VarChar(50)
  description String?  @db.VarChar(500)
  isSecret    Boolean  @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@map("system_settings")
  @@schema("public")
}

model AdminIssue {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  type          String    @default("bug") @db.VarChar(30)
  status        String    @default("todo") @db.VarChar(30)
  priority      String    @default("medium") @db.VarChar(20)
  targetVersion String?   @map("target_version") @db.VarChar(20)
  assignee      String?   @db.VarChar(100)
  labels        String[]  @default([])
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, priority])
  @@index([targetVersion])
  @@map("admin_issues")
  @@schema("public")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())                            // 消息ID，自增主键
  sessionId  Int      @map("session_id")                                       // 所属会话ID
  seqNum     Int      @map("seq_num")                                          // 会话内序号，用于排序
  role       String   @db.VarChar(20)                                          // 角色：system | user | assistant | tool
  content    String?  @db.Text                                                 // 文本内容
  toolCalls  Json?    @map("tool_calls")                                       // AI发起的工具调用 [{id, name, arguments}]
  toolCallId String?  @map("tool_call_id") @db.VarChar(100)                    // 工具调用ID（tool角色消息）
  toolName   String?  @map("tool_name") @db.VarChar(50)                        // 工具名称（tool角色消息）
  toolResult Json?    @map("tool_result")                                      // 工具执行结果（tool角色消息）
  imageUrl   String?  @map("image_url") @db.Text                              // 图片Base64或URL
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)   // 创建时间

  // 关联关系
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seqNum])
  @@index([sessionId])
  @@map("chat_messages")
  @@schema("public")
}
