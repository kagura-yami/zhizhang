# 服务端口
PORT=3006

# JWT 认证密钥（必须修改）
JWT_SECRET=change-me-your-jwt-secret

# PostgreSQL 数据库连接（必须修改）
DATABASE_URL="postgresql://user:password@localhost:5432/zhizhang?sslmode=require"

# API 外部访问地址（可选，用于生成下载链接等，留空则自动从请求中获取）
API_BASE_URL=

# ASR 语音识别配置（可选，用于语音记账功能，兼容 OpenAI Whisper 协议）
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=
# 本机 faster-whisper 服务（配置后优先使用；Docker 后端访问 Windows 主机使用 host.docker.internal）
ASR_LOCAL_URL=
ASR_TIMEOUT_MS=120000

# 收票邮箱授权码加密密钥（至少32个随机字符，只能保存在服务端）
EMAIL_CREDENTIALS_KEY=change-me-to-a-random-secret-at-least-32-characters

# Outlook OAuth2（真实值只放服务器 .env，不要提交仓库）
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_REDIRECT_URI=https://note.kagurayami.top/invoice-mailbox/oauth/outlook/callback

# 发票邮箱后台同步间隔，单位分钟
INVOICE_SYNC_INTERVAL_MINUTES=10
