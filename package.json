{
  "name": "zhizhang",
  "private": true,
  "description": "智能记账应用 Monorepo",
  "scripts": {
    "install:all": "npm --prefix backend install --legacy-peer-deps && npm --prefix mobile install",

    "backend:build": "npm --prefix backend run build",
    "backend:format": "npm --prefix backend run format",
    "backend:start": "npm --prefix backend run start",
    "backend:start:dev": "npm --prefix backend run start:dev",
    "backend:start:debug": "npm --prefix backend run start:debug",
    "backend:start:prod": "npm --prefix backend run start:prod",
    "backend:lint": "npm --prefix backend run lint",
    "backend:test": "npm --prefix backend test",
    "backend:test:watch": "npm --prefix backend run test:watch",
    "backend:test:cov": "npm --prefix backend run test:cov",
    "backend:test:e2e": "npm --prefix backend run test:e2e",
    "backend:prisma:generate": "cd backend && npx prisma generate",
    "backend:prisma:migrate:dev": "cd backend && npx prisma migrate dev",
    "backend:prisma:migrate:deploy": "cd backend && npx prisma migrate deploy",

    "mobile:android": "npm --prefix mobile run android",
    "mobile:android:dev": "npm --prefix mobile run android:dev",
    "mobile:android:prod": "npm --prefix mobile run android:prod",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:ios:dev": "npm --prefix mobile run ios:dev",
    "mobile:ios:prod": "npm --prefix mobile run ios:prod",
    "mobile:start": "npm --prefix mobile start",
    "mobile:start:reset": "npm --prefix mobile run start:reset",
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:lint:fix": "npm --prefix mobile run lint:fix",
    "mobile:test": "npm --prefix mobile test",
    "mobile:test:watch": "npm --prefix mobile run test:watch",
    "mobile:test:coverage": "npm --prefix mobile run test:coverage",
    "mobile:build:dev": "npm --prefix mobile run build:dev",
    "mobile:build:prod": "npm --prefix mobile run build:prod",
    "mobile:clean": "npm --prefix mobile run clean",
    "mobile:release": "npm --prefix mobile run release",
    "mobile:release:patch": "npm --prefix mobile run release:patch",
    "mobile:release:minor": "npm --prefix mobile run release:minor",
    "mobile:release:major": "npm --prefix mobile run release:major",

    "lint:all": "npm --prefix backend run lint && npm --prefix mobile run lint:fix",
    "test:all": "npm --prefix backend test && npm --prefix mobile test"
  }
}
